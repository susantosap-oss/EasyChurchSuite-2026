{
  "name": "@easychurch/easy-presenter",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently \"next dev -p 3001\" \"wait-on http://localhost:3001 && npm run build:electron && electron .\"",
    "build": "node scripts/pack.cjs",
    "build:seed": "node scripts/make-seed.cjs",
    "build:icon": "electron scripts/make-icon.cjs",
    "type-check": "tsc --noEmit",
    "lint": "next lint",
    "build:electron": "tsc -p tsconfig.electron.json",
    "electron": "npm run build:electron && electron ."
  },
  "dependencies": {
    "@easychurch/bible-queries": "workspace:*",
    "@easychurch/db": "workspace:*",
    "@easychurch/scripture": "workspace:*",
    "@easychurch/sync": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "electron-squirrel-startup": "^1.0.1",
    "next": "14.2.18",
    "pdfjs-dist": "3.11.174",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.0",
    "wait-on": "^8.0.1"
  }
}
